{
  "name": "dq-edit-kit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still:briefing": "remotion still src/index.ts Briefing out/briefing-check.png --frame=500",
    "render:briefing": "remotion render src/index.ts Briefing out/DQ_Briefing.mp4 --codec=h264 --crf=18",
    "render:lead": "remotion render src/index.ts QualifiedLead out/DQ_QualifiedLead.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.9.3"
  }
}
